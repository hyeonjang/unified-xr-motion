\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Motion-data contract. A schema defines addressable slots and parent relations; trackers publish partial pose records; binary validity flags identify which components are present; buffer views and serialization expose the same contract to runtime nodes and network transport.}}{4}{}\protected@file@percent }
